<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:VisualElement name="Options" style="flex-grow: 1;">
        <engine:ScrollView style="justify-content: space-around; align-self: stretch; align-content: stretch; flex-grow: 1;">
            <engine:GroupBox name="Graphics" text="Graphic options" style="flex-shrink: 1; flex-grow: 1;">
                <engine:Toggle label="Fullscreen" text="Enable" style="flex-shrink: 1; flex-grow: 1; justify-content: space-around; align-items: auto; align-content: stretch; align-self: center;" />
            </engine:GroupBox>
            <engine:GroupBox name="Theme" text="Theme" style="flex-shrink: 1; flex-grow: 1;">
                <engine:Slider label="Border color" value="0" high-value="1" name="BoardColorSlider" data-source="project://database/Assets/UI/PauseMenu/Options/BoardTileColor.asset?fileID=11400000&amp;guid=2da246a4d8c942c439e4f242bb64ddfb&amp;type=2#BoardTileColor" data-source-path="hue">
                    <engine:VisualElement name="BoardColor" style="flex-grow: 1; background-color: rgb(240, 229, 16);">
                        <Bindings>
                            <engine:DataBinding property="style.backgroundColor" data-source-type="UnityEngine.Color, UnityEngine.CoreModule" binding-mode="TwoWay" data-source="project://database/Assets/UI/PauseMenu/Options/BoardTileColor.asset?fileID=11400000&amp;guid=2da246a4d8c942c439e4f242bb64ddfb&amp;type=2#BoardTileColor" data-source-path="color" />
                        </Bindings>
                    </engine:VisualElement>
                    <Bindings>
                        <engine:DataBinding property="value" data-source-path="hue" data-source="project://database/Assets/UI/PauseMenu/Options/BoardTileColor.asset?fileID=11400000&amp;guid=2da246a4d8c942c439e4f242bb64ddfb&amp;type=2#BoardTileColor" binding-mode="TwoWay" />
                    </Bindings>
                </engine:Slider>
            </engine:GroupBox>
        </engine:ScrollView>
    </engine:VisualElement>
</engine:UXML>
